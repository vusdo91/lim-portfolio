rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 개발 모드: 모든 읽기와 쓰기 허용
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == "vusdo91@gmail.com";
    }

    match /artworks/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /profile/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Visitor counters can only be accessed through the Vercel API.
    match /siteStats/{document=**} {
      allow read, write: if false;
    }
  }
}
